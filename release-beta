#!/bin/bash
# Quick beta release script
# Usage: ./release-beta [version]

set -euo pipefail

echo "🚀 Starting Beta Release Process..."
echo

# Check if we're in the project directory
if [[ ! -f "StorySellerSaver.xcodeproj" ]]; then
    echo "❌ Error: Not in StorySellerSaver project directory"
    echo "Please run this script from the project root"
    exit 1
fi

# Check if remote is configured
if ! git remote get-url origin >/dev/null 2>&1; then
    echo "❌ Error: No GitHub remote configured!"
    echo
    echo "📋 Setup Instructions:"
    echo "1. Create a new repository on GitHub"
    echo "2. Run: git remote add origin https://github.com/YOUR_USERNAME/YOUR_REPO.git"
    echo "3. Run: git push -u origin main"
    echo
    exit 1
fi

# Make script executable and run it
chmod +x scripts/create-beta-release.sh

if [[ $# -eq 0 ]]; then
    echo "🎯 Creating auto-generated beta release..."
    ./scripts/create-beta-release.sh
else
    echo "🎯 Creating beta release v$1..."
    ./scripts/create-beta-release.sh "$1"
fi